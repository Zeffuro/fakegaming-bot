{
  "name": "@zeffuro/fakegaming-bot-dashboard",
  "version": "1.0.0",
  "description": "Dashboard for Fakegaming.eu Bot.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "author": "Zeffuro",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "next build",
    "prebuild": "pnpm -w run gen:api-types",
    "prepare": "pnpm -w run gen:api-types",
    "start": "next start",
    "start:dev": "pnpm --filter @zeffuro/fakegaming-bot-api export:openapi && pnpm -w run gen:api-types && next dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app components i18n lib --ext .ts,.tsx --config ../../eslint.config.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@zeffuro/fakegaming-common": "workspace:*",
    "cross-env": "^10.1.0",
    "discord-api-types": "^0.38.55",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.4",
    "next-intl": "4.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
