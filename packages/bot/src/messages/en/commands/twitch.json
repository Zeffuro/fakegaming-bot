{
    "add-twitch-stream": {
        "description": "Add a Twitch stream for notifications",
        "options": {
            "username": {
                "description": "Twitch username"
            },
            "channel": {
                "description": "Discord channel for notifications"
            },
            "message": {
                "description": "Custom notification message (optional)"
            }
        }
    },
    "manage-twitch-streams": {
        "description": "List, test, pause, resume, or remove Twitch stream notifications",
        "options": {
            "list": {
                "description": "List configured Twitch streams"
            },
            "remove": {
                "description": "Remove a configured Twitch stream",
                "options": {
                    "id": {
                        "description": "Configuration ID from manage-twitch-streams list"
                    }
                }
            },
            "pause": {
                "description": "Pause notifications for a configured Twitch stream",
                "options": {
                    "id": {
                        "description": "Configuration ID from manage-twitch-streams list"
                    }
                }
            },
            "resume": {
                "description": "Resume notifications for a configured Twitch stream",
                "options": {
                    "id": {
                        "description": "Configuration ID from manage-twitch-streams list"
                    }
                }
            },
            "test": {
                "description": "Show latest health for a configured Twitch stream",
                "options": {
                    "id": {
                        "description": "Configuration ID from manage-twitch-streams list"
                    }
                }
            }
        }
    },
    "stream-status": {
        "description": "Check whether a Twitch channel is live",
        "options": {
            "username": {
                "description": "Twitch username"
            }
        }
    },
    "twitch-latest-vod": {
        "description": "Show the latest Twitch archive VOD for a channel",
        "options": {
            "username": {
                "description": "Twitch username"
            }
        }
    }
}
