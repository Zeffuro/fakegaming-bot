{
    "notes": {
        "description": "Manage your personal notes and saved inbox",
        "options": {
            "add": {
                "description": "Save a personal note",
                "options": {
                    "body": {
                        "description": "Note text"
                    },
                    "title": {
                        "description": "Optional note title"
                    },
                    "pinned": {
                        "description": "Pin this note to the top of your list"
                    },
                    "tags": {
                        "description": "Comma-separated tags (up to 10)"
                    },
                    "source-url": {
                        "description": "Optional source link (HTTP or HTTPS)"
                    }
                }
            },
            "list": {
                "description": "List your personal notes",
                "options": {
                    "query": {
                        "description": "Search note titles and text"
                    },
                    "tag": {
                        "description": "Filter by one tag"
                    },
                    "status": {
                        "description": "Filter by inbox state",
                        "choices": {
                            "active": "Active",
                            "unread": "Unread",
                            "read": "Read",
                            "archived": "Archived",
                            "all": "All"
                        }
                    },
                    "page": {
                        "description": "Page number"
                    }
                }
            },
            "show": {
                "description": "Show one of your notes",
                "options": {
                    "note": {
                        "description": "Note number from /notes list or its short ID"
                    }
                }
            },
            "delete": {
                "description": "Delete one of your notes",
                "options": {
                    "note": {
                        "description": "Note number from /notes list or its short ID"
                    }
                }
            },
            "edit": {
                "description": "Update tags or inbox state",
                "options": {
