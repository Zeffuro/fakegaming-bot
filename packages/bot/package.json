{
  "name": "@zeffuro/fakegaming-bot",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "description": "",
  "author": "Zeffuro",
  "license": "AGPL-3.0-only",
  "scripts": {
    "prebuild": "tsx ../../scripts/generate-bot-manifest.ts && pnpm -C ../../packages/common build",
    "build": "pnpm --filter @zeffuro/fakegaming-common run build && tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "prod:dev": "cross-env NODE_ENV=production tsx src/index.ts",
    "start:dev": "cross-env NODE_ENV=development tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts --config ../../eslint.config.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "profile": "node --inspect-brk dist/index.js"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@zeffuro/fakegaming-common": "workspace:*",
    "axios": "^1.20.0",
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "discord-api-types": "^0.38.57",
    "discord.js": "^14.27.0",
    "ms": "^2.1.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "twisted": "^1.83.0",
    "use-intl": "4.14.9",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
